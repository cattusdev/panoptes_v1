<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Panoptes_v1-91c80199-7d50-4df0-b527-b026d72dd0b7</UserSecretsId>
    <ClientRoot>$(MSBuildProjectDirectory)\..\Panoptes_v1.Client\</ClientRoot>
  </PropertyGroup>

  <!-- React client: χτίζεται αν λείπει το wwwroot/spa (π.χ. μετά από clone). Για αλλαγές: npm run build ή npm run dev. -->
  <Target Name="BuildClientIfMissing" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\spa\index.html')">
    <Exec Command="npm install" WorkingDirectory="$(ClientRoot)" Condition="!Exists('$(ClientRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientRoot)" />
  </Target>

  <!-- Publish: πάντα φρέσκο build του client μέσα στο publish output -->
  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm ci" WorkingDirectory="$(ClientRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientRoot)" />
    <ItemGroup>
      <ClientDistFiles Include="wwwroot\spa\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\spa\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
