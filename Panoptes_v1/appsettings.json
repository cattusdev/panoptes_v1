{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=Panoptesv1;Username=postgres"
  },
  "SmtpSettings": {
    "Server": "",
    "Port": 587,
    "Security": "StartTls",
    "SenderName": "Panoptes v1.0",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Media": {
    "Provider": "FileSystem",
    "Root": "App_Data/media",
    "TempRoot": "App_Data/media-tmp",
    "AllowSvg": false,
    "S3": {
      "ServiceUrl": "",
      "Region": "auto",
      "PublicBucket": "",
      "PrivateBucket": "",
      "PublicBaseUrl": ""
    }
  },
  "AllowedHosts": "*"
}
